# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP INTEGRATION SERVICE CONFIGURATION
# Supported values: "meta", "gupshup", or leave empty to default to fallback simulation logs.
WHATSAPP_PROVIDER="meta"

# Meta Cloud API settings (configured inside Facebook developers portal)
WHATSAPP_API_URL="https://graph.facebook.com/v18.0/1234567890/messages"
WHATSAPP_API_TOKEN="EAAGb..."
WHATSAPP_SENDER_PHONE_NUMBER_ID="1234567890"

# Gupshup settings (if "gupshup" is selected as WHATSAPP_PROVIDER)
GUPSHUP_API_KEY="your_gupshup_api_key_here"
GUPSHUP_SENDER_NAME="your_gupshup_source_sender_name_here"

# Webhook secret used to securely verify meta subscription/handshake challenges
WHATSAPP_VERIFY_TOKEN="studio-webhook-token-supersecure-123"

# Registered WhatsApp templates
WHATSAPP_WELCOME_TEMPLATE_ID="welcome_confirmation_v1"
WHATSAPP_REMINDER_TEMPLATE_ID="event_cutoff_reminder_v1"

