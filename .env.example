# Firebase Web Config (copy from Firebase Console → Project Settings → Your Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# App URL (your deployed domain, used for self-referential links)
APP_URL=

# Gemini AI (optional for production v1)
GEMINI_API_KEY=

# WhatsApp — deferred to Phase 2
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=